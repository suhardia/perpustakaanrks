# Salin file ini menjadi .env.local lalu isi dari Supabase:
# Dashboard Supabase -> Project Settings -> API (atau tombol "Connect")
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Proyek Supabase lama memakai "anon key". Jika itu yang Anda punya, isi baris ini dan kosongkan PUBLISHABLE_KEY:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
